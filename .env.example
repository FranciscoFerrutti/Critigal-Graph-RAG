# Credenciales ACLED (OAuth2 — registrarse en https://acleddata.com/)
# La API usa username + password para obtener un Bearer token.
# El token expira en 24h; el refresh token dura 14 días.
ACLED_USERNAME=tu_email@ejemplo.com
ACLED_PASSWORD=tu_password

# Neo4j (levantado con docker-compose)
NEO4J_URI=bolt://localhost:7687

# Autenticación básica (usuario + contraseña) — PRIORIDAD 1
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Autenticación OAuth2 / SSO (client credentials) — PRIORIDAD 2
# Solo se usa si NEO4J_USER y NEO4J_PASSWORD NO están definidos.
# NEO4J_CLIENT_ID=tu_client_id
# NEO4J_CLIENT_SECRET=tu_client_secret

# -----------------------------------------------------------------------------
# Proveedores de LLM / embeddings
# -----------------------------------------------------------------------------
# Cada config YAML (config/embeddings.yaml, config/agent.yaml) referencia la
# env var que contiene la API key. Cambiar de proveedor = editar el YAML y
# agregar la key correspondiente acá.

# Gemini (default para embeddings y agente)
GOOGLE_API_KEY=tu_google_api_key

# OpenAI (opcional, si se cambia embeddings.yaml o agent.yaml a provider: openai)
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
